# Credenciales de PostgreSQL
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

# Secreto para firmar los JWT (¡CAMBIA ESTO en producción!)
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# Duración del token
JWT_EXPIRES_IN=8h

# Puerto público del frontend en el host
CLIENT_PORT=8080
