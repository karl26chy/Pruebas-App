# Server
PORT=5000
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS, separados por coma.
# Vacío = cualquier origen (desarrollo local).
# Producción: CORS_ORIGIN=https://frontend.onrender.com
CORS_ORIGIN=

# El pool de PostgreSQL habilita SSL automáticamente para hosts remotos
# (Supabase, Render, etc.). En localhost no usa SSL.
